<html lang="en">
<head>
<meta charset="UTF-8">
<title>Development Feasibility — ${j.name}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap');
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    --navy:#1A3D7C;--navy2:#2952A3;--gold:#E0AC2F;--gold2:#F4CE6B;
    --ink:#0d1117;--ink2:#1c2128;--ink3:#24292f;
    --line:#c6cdd5;--bg:#eef1f4;--white:#fff;
    --grn:#1a7f37;--grn-bg:#e6f6ec;
  }
  body{
    font-family:'Inter',sans-serif;font-size:9.5px;color:var(--ink);
    background:var(--white);width:210mm;min-height:297mm;
    padding:30mm 16mm 14mm 16mm;
  }

  /* ── HEADER ── */
  .hdr{
    display:flex;justify-content:space-between;align-items:flex-start;
    padding-bottom:12px;margin-bottom:14px;
    border-bottom:1px solid var(--line);
  }
  .hdr-brand{display:flex;align-items:center;gap:8px}
  .hdr-title{font-size:18px;font-weight:800;color:var(--ink);letter-spacing:1.5px;
    line-height:1;text-transform:uppercase}
  .hdr-sub{font-size:8px;color:var(--ink3);margin-top:5px;letter-spacing:.3px}
  .hdr-meta{text-align:right;font-size:8px;color:var(--ink3);line-height:1.8}
  .hdr-meta strong{font-size:9px;color:var(--ink);font-weight:700;display:block}

  /* ── FAR BADGE ── */
  .badge{
    display:inline-flex;align-items:center;gap:5px;
    background:var(--navy);color:var(--gold2);
    border:1px solid var(--navy);border-radius:14px;padding:3px 12px;
    font-size:8px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;
    margin-bottom:12px;
  }

  /* ── HERO NUMBERS ── */
  .hero{
    display:flex;justify-content:space-between;align-items:flex-start;
    background:rgba(26,61,124,0.10);
    border:1px solid var(--line);border-radius:6px;
    padding:14px 18px;margin-bottom:10px;
    border-left:6px solid var(--navy);
  }
  .hero-left{display:flex;flex-direction:column}
  .hero-eyebrow{font-size:8px;color:var(--navy2);letter-spacing:1.5px;
    text-transform:uppercase;margin-bottom:6px;font-weight:700}
  .hero-val{font-size:40px;font-weight:800;color:var(--navy);line-height:1}
  .hero-lbl{font-size:8.5px;color:var(--ink3);margin-top:5px}
  .hero-right{text-align:right;display:flex;flex-direction:column;align-items:flex-end}
  .hero-right-lbl{font-size:8px;color:var(--ink3);letter-spacing:1px;
    text-transform:uppercase;margin-bottom:3px;font-weight:700}
  .hero-right-val{font-size:24px;font-weight:800;color:var(--navy2)}
  .hero-right-sub{font-size:8.5px;color:var(--ink3);margin-top:2px}

  /* ── SECTIONS ── */
  .sec-wrap{display:table;table-layout:fixed;width:100%;margin-bottom:10px;border-spacing:0}
  .sec-wrap > .sec{display:table-cell;width:50%;vertical-align:top}
  .sec-wrap > .sec:first-child{padding-right:20px}
  .sec-wrap > .sec:nth-child(2){padding-left:20px}
  .sec-wrap.full{display:block;margin-bottom:10px}
  .sec{background:none;border:none}
  .sec-body{padding:0;width:100%}
  .sec-head{
    color:var(--navy);border-bottom:2px solid var(--navy);
    font-size:8px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;
    padding:0 0 4px 0;margin-bottom:4px;
  }
  .row{display:flex;align-items:baseline;
    width:100%;padding:4px 0;gap:8px}
  .row.hi{font-weight:700;background:rgba(26,61,124,0.08);
    margin:0 -8px;padding:4px 8px;border-radius:3px}
  .rl{color:var(--ink2);font-size:9px;flex-shrink:0;width:38%}
  .rv{font-size:9px;font-weight:500;color:var(--ink);text-align:right;flex:1}
  .sec-left .row{justify-content:flex-start}
  .sec-left .rl{width:34%}
  .sec-left .rv{text-align:left;flex:none}
  .row.hi .rl,.row.hi .rv{font-weight:700;color:var(--navy);font-size:9.5px}

  .ref-note{
    margin-top:8px;padding:6px 9px;
    background:#fbf6e9;border-left:2.5px solid var(--gold);border-radius:0 3px 3px 0;
    font-size:8px;line-height:1.55;color:var(--ink3);
  }
  .ref-note b{color:var(--ink2)}

  .inc-row{display:flex;justify-content:space-between;padding:5px 8px;
    border-bottom:1px solid var(--line);font-size:9px;background:var(--grn-bg)}
  .inc-row:nth-child(odd){background:#f3faf5}
  .inc-row span:last-child{color:var(--grn);font-weight:700}
  .inc-tot{display:flex;justify-content:space-between;padding:6px 8px;
    font-size:9.5px;font-weight:700;color:var(--ink)}

  .notice{
    margin-top:8px;padding:6px 10px;
    background:#fdf6e3;border-left:4px solid var(--gold);
    border-radius:0 4px 4px 0;font-size:7.5px;color:var(--ink2);line-height:1.5
  }

  .refs{
    margin-top:5px;padding:5px 8px;
    border:1px solid var(--line);border-radius:4px;
    font-size:7.5px;color:var(--ink3);line-height:1.8
  }
  .refs strong{color:var(--navy);font-size:8px;letter-spacing:1.5px;text-transform:uppercase;
    display:block;margin-bottom:4px}

  .footer{
    margin-top:6px;padding-top:4px;border-top:1px solid var(--line);
    display:flex;justify-content:space-between;
    font-size:7.5px;color:var(--ink3)
  }

  @media print{
    *{ -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color-adjust: exact !important; }
    body{padding:10mm 12mm 10mm 12mm !important; background:#ffffff !important;}
    @page{size:A4 portrait; margin:0}
    .sec{page-break-inside:avoid}
  }
</style>
</head>
<body>

<!-- HEADER -->
<div class="hdr">
  <div class="hdr-brand">
    <div>
