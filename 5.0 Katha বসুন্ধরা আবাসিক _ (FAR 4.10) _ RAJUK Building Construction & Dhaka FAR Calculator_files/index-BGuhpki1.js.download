ng:"3. Cookies, Google Analytics and Meta Pixel",children:[s.jsxs("p",{children:["We use cookies and similar technologies to keep you signed in and remember preferences. We also use"," ",s.jsx("b",{children:"Google Analytics"})," to measure traffic and ",s.jsx("b",{children:"Meta Pixel"})," to measure the effectiveness of our advertising on Facebook and Instagram. These services may set cookies and receive information such as your IP address, device identifiers and the pages you visit. Our site may also display advertising served by Google."]}),s.jsx("p",{children:"You can block or delete cookies in your browser settings, and opt out of Google Analytics with Google’s browser add-on or of personalised ads in your Google and Meta ad settings. Some features may not work without cookies."})]}),s.jsx(Kl,{heading:"4. Service providers",children:s.jsx("p",{children:"We share information only with providers that help us run the service, such as Google (Firebase authentication and database, Google Maps, Google Analytics, Cloud hosting), Meta (Pixel) and our email delivery provider. They may process data only to perform services for us or as described in their own privacy policies. We do not sell your personal information."})}),s.jsx(Kl,{heading:"5. Retention and security",children:s.jsx("p",{children:"We keep information for as long as your account is active or as needed to provide the service, keep billing records and meet legal obligations. We use reasonable technical and organisational safeguards, but no online service can be guaranteed to be completely secure."})}),s.jsx(Kl,{heading:"6. Your choices",children:s.jsx("p",{children:"You may request access to, correction of, or deletion of your personal information, and may unsubscribe from non-essential emails at any time, by contacting us. We may need to keep certain billing records where required by law."})}),s.jsx(Kl,{heading:"7. Children",children:s.jsx("p",{children:"The service is intended for adults and professionals. It is not directed at children under 13, and we do not knowingly collect their information."})}),s.jsx(Kl,{heading:"8. Changes to this policy",children:s.jsx("p",{children:"We may update this policy from time to time. The “Last updated” date above shows the current version; continued use of the service after a change means you accept the updated policy."})}),s.jsx(Kl,{heading:"9. Contact",children:s.jsx(xG,{})})]}),ETe=()=>s.jsxs("article",{className:"max-w-none",children:[s.jsx(gG,{title:"Terms of Service"}),s.jsx("p",{className:"text-sm leading-relaxed text-slate-300",children:"These Terms of Service govern your use of FAR Calculator at farcalculator.com. By using the service you agree to them."}),s.jsx(Kl,{heading:"1. The service",children:s.jsx("p",{children:"FAR Calculator is a planning assessment tool that estimates Floor Area Ratio, ground coverage, setbacks and related figures under RAJUK rules and generates reports. We may change, suspend or discontinue features at any time."})}),s.jsx(Kl,{heading:"2. Informational use only",children:s.jsxs("p",{children:["Results are informational estimates. They ",s.jsx("b",{children:"do not constitute official approval"})," or legal, architectural or engineering advice. Planning rules, data and interpretations change, and may be applied differently by the authority. You are responsible for verifying every result against the current official regulations and with the relevant authority and qualified professionals before relying on it for design, purchase, construction or approval."]})}),s.jsx(Kl,{heading:"3. Accounts and user responsibilities",children:s.jsxs("ul",{className:"list-disc pl-5 space-y-1.5",children:[s.jsx("li",{children:"You must provide accurate information and keep your account secure."}),s.jsx("li",{children:"You are responsible for the data you enter and for all activity under your account."}),s.jsx("li",{children:"You must not misuse the service: no scraping, reverse engineering, overloading, unauthorised access, or use in violation of law."}),s.jsx("li",{children:"You must not share your paid access with others or resell the service without our written consent."})]})}),s.jsx(Kl,{heading:"4. Subscriptions and billing",children:s.jsx("p",{children:"Some features require a paid subscription. Prices, plan durations and payment methods are shown when you subscribe. Payments are verified manually or through our payment partners, and access is activated once a payment is confirmed. Except where required by law, fees are non-refundable once access has been activated."})}),s.jsx(Kl,{heading:"5. Intellectual property",children:s.jsx("p",{children:"The service, including its software, design, data compilations and content, is owned by us or our licensors and protected by law. You keep ownership of the project data you enter, and grant us a licence to store and process it to provide the service."})}),s.jsx(Kl,{heading:"6. Disclaimer of warranties",children:s.jsx("p",{children:"The service is provided “as is” and “as available” without warranties of any kind, express or implied, including accuracy, completeness, fitness for a particular purpose and uninterrupted availability."})}),s.jsx(Kl,{heading:"7. Limitation of liability",children:s.jsx("p",{children:"To the maximum extent permitted by law, we are not liable for any indirect, incidental or consequential loss, or any loss arising from reliance on the results, including rejected applications, redesign costs or lost profits. Our total liability for any claim is limited to the amount you paid us in the three months before the claim."})}),s.jsx(Kl,{heading:"8. Termination",children:s.jsx("p",{children:"We may suspend or terminate access if you breach these Terms or misuse the service. You may stop using the service at any time."})}),s.jsx(Kl,{heading:"9. Governing law and changes",children:s.jsxs("p",{children:["These Terms are governed by the laws of Bangladesh. We may update them from time to time; continued use after the “Last updated” date means you accept the revised Terms. Our use of personal data is described in our"," ",s.jsx("a",{className:"text-indigo-400 hover:underline",href:"/privacy",children:"Privacy Policy"}),"."]})}),s.jsx(Kl,{heading:"10. Contact",children:s.jsx(xG,{})})]}),TTe=()=>s.jsx(ug,{title:"Privacy Policy | RAJUK FAR Calculator",metaDescription:"How FAR Calculator collects, uses and protects your information, including account data, phone numbers, billing details and cookies for Google Analytics and Meta Pixel.",canonicalUrl:"https://farcalculator.com/privacy",breadcrumbTitle:"Privacy Policy",children:s.jsx(ATe,{})}),CTe=()=>s.jsx(ug,{title:"Terms of Service | RAJUK FAR Calculator",metaDescription:"Terms of Service for FAR Calculator: informational use of results, account responsibilities, subscriptions and billing, and limitations of liability.",canonicalUrl:"https://farcalculator.com/terms",breadcrumbTitle:"Terms of Service",children:s.jsx(ETe,{})});typeof window<"u"&&window.addEventListener("error",n=>{if(n.message&&(n.message.includes("$$typeof")||n.message.includes("Blocked a frame with origin")))return n.stopImmediatePropagation(),n.preventDefault(),!0});kW.createRoot(document.getElementById("root")).render(s.jsx(q.StrictMode,{children:s.jsx(JO,{children:s.jsx(tY,{children:s.jsxs(MK,{children:[s.jsx(yf,{path:"/",element:s.jsx(xTe,{})}),s.jsx(yf,{path:"/guide/far-calculation",element:s.jsx(bTe,{})}),s.jsx(yf,{path:"/guide/setback-rules",element:s.jsx(vTe,{})}),s.jsx(yf,{path:"/guide/mgc",element:s.jsx(yTe,{})}),s.jsx(yf,{path:"/guide/dap-zones",element:s.jsx(NTe,{})}),s.jsx(yf,{path:"/faq",element:s.jsx(wTe,{})}),s.jsx(yf,{path:"/privacy",element:s.jsx(TTe,{})}),s.jsx(yf,{path:"/terms",element:s.jsx(CTe,{})})]})})})}));export{Fi as _,Km as c,$1 as g};
