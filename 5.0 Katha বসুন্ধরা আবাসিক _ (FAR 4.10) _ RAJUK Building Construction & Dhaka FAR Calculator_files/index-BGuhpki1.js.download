 font-bold",children:"60.0%"}),s.jsx("td",{className:"p-4 text-cyan-400 font-bold",children:"50.0%"})]}),s.jsxs("tr",{className:"hover:bg-slate-800/40 transition-colors",children:[s.jsx("td",{className:"p-4 font-semibold text-white",children:"Large Plots (> 10 Katha / 1 Bigha)"}),s.jsx("td",{className:"p-4 text-emerald-400 font-bold",children:"50.0%"}),s.jsx("td",{className:"p-4 text-indigo-400 font-bold",children:"55.0%"}),s.jsx("td",{className:"p-4 text-cyan-400 font-bold",children:"45.0%"})]})]})]})})}),s.jsxs("section",{className:"mb-10 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 md:p-8",children:[s.jsx("h2",{className:"text-xl md:text-2xl font-bold text-white mb-3",children:"3. How MGC and FAR Work Together (এমজিসি ও এফএআর এর সম্পর্ক)"}),s.jsxs("div",{className:"space-y-4 text-sm text-slate-300 leading-relaxed",children:[s.jsxs("p",{children:["While ",s.jsx("strong",{children:"FAR determines total 3D building volume across all floors"}),", ",s.jsx("strong",{children:"MGC controls the maximum 2D horizontal building footprint on the ground"}),"."]}),s.jsxs("div",{className:"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2",children:[s.jsxs("p",{children:["• ",s.jsx("strong",{children:"High MGC (65%):"})," Produces wider, stockier buildings with fewer floors."]}),s.jsxs("p",{children:["• ",s.jsx("strong",{children:"Low MGC (50%):"})," Encourages taller, slimmer towers with abundant green open space on the ground."]}),s.jsxs("p",{children:["• ",s.jsx("strong",{children:"Unbuilt Open Space Rule:"})," Minimum 50% of open ground space must remain soft unpaved soil to allow natural groundwater recharge under BNBC environmental regulations."]})]})]})]})]})}),NTe=()=>s.jsx(ug,{title:"RAJUK DAP 2022-2035 Density Zone Guide | Dhaka FAR Zones",metaDescription:"Explore RAJUK DAP 2022-2035 density blocks and zoning rules in Dhaka. Learn how location, block FAR, and road width affect plot development potential.",canonicalUrl:"https://farcalculator.com/guide/dap-zones",breadcrumbTitle:"DAP 2022-2035 Zone Guide",children:s.jsxs("article",{className:"prose prose-invert max-w-none",children:[s.jsxs("header",{className:"mb-8 border-b border-slate-800 pb-6",children:[s.jsx("span",{className:"inline-block px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-xs font-semibold mb-3",children:"RAJUK Gazette Appendix 3.6"}),s.jsx("h1",{className:"text-3xl md:text-4xl font-extrabold text-white tracking-tight",children:"DAP 2022–2035 Density Zone Guide (ডিএপি ডেনসিটি ব্লক নির্দেশিকা)"}),s.jsx("p",{className:"text-slate-300 text-lg mt-3 leading-relaxed",children:"Understanding RAJUK DAP 68 Density Blocks (Block-01 to Block-68), Area FAR (aFAR), and Planning Road Width Thresholds across Dhaka."})]}),s.jsxs("section",{className:"mb-10 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 md:p-8",children:[s.jsxs("h2",{className:"text-xl md:text-2xl font-bold text-white mb-3 flex items-center gap-2",children:[s.jsx(T0,{className:"w-6 h-6 text-indigo-400"}),s.jsx("span",{children:"1. What are DAP 2022-2035 Density Blocks? (ডিএপি ডেনসিটি ব্লক কী?)"})]}),s.jsxs("p",{className:"text-slate-300 leading-relaxed mb-4",children:["Under the Detailed Area Plan (DAP 2022–2035), RAJUK divided the greater Dhaka metropolitan area into ",s.jsx("strong",{children:"68 designated Density Blocks"})," (Block-01 through Block-68)."]}),s.jsxs("p",{className:"text-slate-300 leading-relaxed",children:["প্রতিটি ব্লকের জন্য জনসংখ্যা ঘনত্ব (Population Density per Acre) এবং এলাকার অবকাঠামো বিবেচনায় আলাদা ",s.jsx("strong",{children:"Area FAR (aFAR)"})," ও বাসস্থান ইউনিট ক্যাপ (Dwelling Units Limit) নির্ধারণ করা হয়েছে।"]})]}),s.jsxs("section",{className:"mb-10",children:[s.jsx("h2",{className:"text-xl md:text-2xl font-bold text-white mb-4",children:"2. Primary DAP Zone Categories"}),s.jsxs("div",{className:"grid grid-cols-1 md:grid-cols-2 gap-4",children:[s.jsxs("div",{className:"bg-slate-900 border border-slate-800 rounded-xl p-5",children:[s.jsx("span",{className:"text-xs font-bold text-emerald-400 uppercase tracking-wider block mb-1",children:"High Infrastructure Density"}),s.jsx("h3",{className:"text-lg font-bold text-white mb-2",children:"Planned Model Towns (উন্নত পরিকল্পিত এলাকা)"}),s.jsx("p",{className:"text-xs text-slate-300 leading-relaxed",children:"Areas like Gulshan, Banani, Uttara Model Town, Dhanmondi, and Baridhara possess wide road networks and high base Area FAR (aFAR 3.25 to 3.75)."})]}),s.jsxs("div",{className:"bg-slate-900 border border-slate-800 rounded-xl p-5",children:[s.jsx("span",{className:"text-xs font-bold text-amber-400 uppercase tracking-wider block mb-1",children:"Traditional Urban Core"}),s.jsx("h3",{className:"text-lg font-bold text-white mb-2",children:"Puran Dhaka / Old Dhaka (পুরাতন ঢাকা অঞ্চল)"}),s.jsx("p",{className:"text-xs text-slate-300 leading-relaxed",children:"Special density corridors in Lalbagh, Sutrapur, Kotwali, and Bangshal follow unique heritage FAR rules, narrow lane allowances, and tailored setbacks."})]}),s.jsxs("div",{className:"bg-slate-900 border border-slate-800 rounded-xl p-5",children:[s.jsx("span",{className:"text-xs font-bold text-indigo-400 uppercase tracking-wider block mb-1",children:"Developing Suburb Corridors"}),s.jsx("h3",{className:"text-lg font-bold text-white mb-2",children:"Rapid Growth Suburban Zones (উদীয়মান উপশহর)"}),s.jsx("p",{className:"text-xs text-slate-300 leading-relaxed",children:"Bosila, Rayer Bazar, Mugda, Khilgaon, Matuail, and Keraniganj feature evolving road infrastructure where road widening generates instant FAR upgrades."})]}),s.jsxs("div",{className:"bg-slate-900 border border-slate-800 rounded-xl p-5",children:[s.jsx("span",{className:"text-xs font-bold text-cyan-400 uppercase tracking-wider block mb-1",children:"Incentive Planned Schemes"}),s.jsx("h3",{className:"text-lg font-bold text-white mb-2",children:"Block Housing & Large Plots (ব্লক হাউজিং)"}),s.jsx("p",{className:"text-xs text-slate-300 leading-relaxed",children:"Plots greater than 20 Katha (1 Bigha) qualify for DAP Section 3.28 incentives, giving up to +25% bonus FAR and increased height caps."})]})]})]}),s.jsxs("section",{className:"mb-10 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 md:p-8",children:[s.jsx("h2",{className:"text-xl md:text-2xl font-bold text-white mb-3",children:"3. Understanding pFAR vs aFAR"}),s.jsxs("div",{className:"space-y-3 text-sm text-slate-300 leading-relaxed",children:[s.jsxs("p",{children:["Under RAJUK DAP rules, final approved FAR is calculated as the lower of ",s.jsx("strong",{children:"Road Width FAR (pFAR)"})," and ",s.jsx("strong",{children:"Area Density FAR (aFAR)"}),", plus any statutory incentives:"]}),s.jsx("div",{className:"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2 font-mono text-xs text-indigo-300",children:"Approved FAR = Min(Road FAR pFAR, Area FAR aFAR) + Block Housing Bonus + Road Widening Incentive"})]})]})]})}),STe=[{qEn:"How many floors can be built per katha of land in Dhaka? (কত কাঠা জমিতে কত তলা করা যাবে?)",qBn:"কত কাঠা জমিতে কত তলা করা যাবে?",aEn:"The number of allowable floors is NOT fixed solely by plot size in katha. It is determined by the total allowable Floor Area Ratio (FAR), Maximum Ground Coverage (MGC), plot area, and front access road width under RAJUK DAP 2022-2035. For example, a 3 Katha plot on a 20ft road typically permits G+5 to G+6 floors, whereas a 5 Katha plot on a 30ft road can achieve G+7 to G+8 floors.",aBn:"জমির কাঠার ওপর ভিত্তি করে তলা নির্ধারিত হয় না; বরং রাজউক ডিএপি (DAP 2022-2035) নিয়ম অনুযায়ী অনুমোদনযোগ্য মোট এফএআর (FAR), গ্রাউন্ড কভারেজ (MGC) এবং সামনের রাস্তার চওড়ার ওপর নির্ভর করে। যেমন: ২০ ফিট রাস্তায় ৩ কাঠা জমিতে সাধারণত ৬ তলা (G+5) এবং ৩০ ফিট রাস্তায় ৫ কাঠা জমিতে ৮ তলা (G+7) পর্যন্ত নির্মাণ সম্ভব।",category:"Floor Counts"},{qEn:"What is Floor Area Ratio (FAR) and how does it affect my plot value?",qBn:"এফএআর (FAR) কী এবং এটি কীভাবে প্লটের মান নির্ধারণ করে?",aEn:"FAR is the multiplier of plot area that dictates maximum built-up floor area. A higher FAR allows developers and homeowners to construct more square footage on the same plot, increasing apartment yield and project ROI significantly.",aBn:"এফএআর হলো এমন একটি গুণক সংখ্যা যা আপনার জমিতে মোট কত বর্গফুট ফ্ল্যাট বা ফ্লোর স্পেস নির্মাণ করা যাবে তা নির্ধারণ করে। এফএআর যত বেশি হবে, আপনি তত বেশি বর্গফুট নির্মাণ করে লাভবান হতে পারবেন।",category:"FAR Basics"},{qEn:"What is the minimum road width required for building approval in Dhaka?",qBn:"ঢাকা শহরে ইমারত অনুমোদনের জন্য সর্বনিম্ন রাস্তার চওড়া কত প্রয়োজন?",aEn:"Under Imarot Nirman Bidhimala 2025, the minimum required access road width is 12 Feet (3.65m) for standard residential plots. However, roads narrower than 20 Feet (6.10m) receive lower base FAR. Surrendering front land to achieve a 20ft or 30ft road unlocks higher FAR tiers.",aBn:"আবাসিক প্লটের জন্য সর্বনিম্ন ১২ ফিট (৩.৬৫ মিটার) চওড়া রাস্তা থাকা আবশ্যক। তবে রাস্তার চওড়া ২০ ফিট বা ৩০ ফিট বা তার বেশি হলে রাজউক অনেক বেশি এফএআর এবং অতিরিক্ত তলা অনুমোদনের সুযোগ দেয়।",category:"Road Width"},{qEn:"What are side and rear setback rules for 6-storey vs 10-storey buildings?",qBn:"৬ তলা ও ১০ তলা ভবনের জন্য সাইড ও রিয়ার সেটব্যাক বা ফাঁকা জায়গা কত ছাড়তে হয়?",aEn:"Up to 7 storeys (≤20m height), minimum side setback is 1.00m (3.28ft) and rear setback is 1.25m (4.10ft). For 8 to 10 storeys (20m–30m height), side setback increases to 1.25m (4.10ft) and rear setback increases to 2.00m (6.56ft).",aBn:"৭ তলা (সর্বোচ্চ ২০ মিটার উচ্চতা) পর্যন্ত পাশের সেটব্যাক ১.০০ মিটার (৩.২৮ ফিট) এবং পেছনের সেটব্যাক ১.২৫ মিটার (৪.১০ ফিট)। ৮ থেকে ১০ তলার জন্য পাশে ১.২৫ মিটার এবং পেছনে ২.০০ মিটার ফাঁকা রাখতে হয়।",category:"Setbacks"},{qEn:"How does Block Housing offer bonus FAR under DAP Section 3.28?",qBn:"ব্লক হাউজিং (Block Housing) স্কিমে কীভাবে অতিরিক্ত বোনাস এফএআর পাওয়া যায়?",aEn:"When landowners amalgamate plots into planned block schemes exceeding 20 Katha (1 Bigha) or 1 Acre, RAJUK grants +15% to +25% bonus FAR, increased MGC, and height relaxations under DAP Section 3.28 guidelines.",aBn:"একাধিক প্লট একত্রিত করে ২০ কাঠা (১ বিঘা) বা তার বেশি আয়তনের ব্লক হাউজিং তৈরি করলে রাজউক ডিএপি ৩.২৮ ধারা অনুযায়ী ১৫% থেকে ২৫% পর্যন্ত অতিরিক্ত বোনাস এফএআর প্রদান করে।",category:"Incentives"},{qEn:"What is the permissible Dwelling Units (UPK) limit per plot?",qBn:"প্লটে সর্বোচ্চ কতটি ফ্ল্যাট বা বাসস্থান ইউনিট (Dwelling Units) করা সম্ভব?",aEn:"RAJUK DAP calculates the Dwelling Units Cap using the Unit Per Katha (UPK) factor assigned to each Density Block (Block-01 to Block-68). The formula is: Max Units = Plot Katha × Block UPK. Small plot relaxations allow a minimum of 4 to 6 units.",aBn:"প্রতিটি ডিএপি ব্লকের জন্য নির্ধারিত ইউপিকে (UPK) ফ্যাক্টর দিয়ে প্লটের কাঠাকে গুণ করে সর্বোচ্চ ফ্ল্যাট সংখ্যা পাওয়া যায়। ছোট প্লটের ক্ষেত্রে সর্বনিম্ন ৪ থেকে ৬ টি ইউনিট নির্মাণের ছাড় রয়েছে।",category:"Units Cap"}],wTe=()=>{const[n,e]=q.useState(0),t=r=>{e(n===r?null:r)};return s.jsx(ug,{title:"RAJUK FAR & Building Rules FAQ | কত কাঠা জমিতে কত তলা করা যাবে?",metaDescription:"Answers to common questions on RAJUK DAP 2022-2035 building rules, floor counts per katha, setback requirements, and FAR calculations in Bangladesh.",canonicalUrl:"https://farcalculator.com/faq",breadcrumbTitle:"Frequently Asked Questions (FAQ)",children:s.jsxs("article",{className:"prose prose-invert max-w-none",children:[s.jsxs("header",{className:"mb-8 border-b border-slate-800 pb-6",children:[s.jsx("span",{className:"inline-block px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-xs font-semibold mb-3",children:"Bilingual Architecture & Planning FAQ"}),s.jsx("h1",{className:"text-3xl md:text-4xl font-extrabold text-white tracking-tight",children:"Frequently Asked Questions (প্রশ্নোত্তর)"}),s.jsx("p",{className:"text-slate-300 text-lg mt-3 leading-relaxed",children:"Find instant answers to common questions about RAJUK DAP 2022–2035, Imarot Nirman Bidhimala 2025, floor count per katha, setbacks, and buil