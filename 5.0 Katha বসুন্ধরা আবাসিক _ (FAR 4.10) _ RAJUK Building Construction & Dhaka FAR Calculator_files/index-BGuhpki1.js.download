  "schemaVersion": "1.0",
  "phase": "R3",
  "aerodrome": "HSIA (VGHS)",
  "purpose": "Source-traced parameters the R3 HSIA OLS repair needs beyond reports/phase-c2a-hsia-input-snapshot.json. No value here is derived from any CAAB clearance letter.",
  "clearways": {
    "note": "A clearway listed for a designator lies beyond the END of that designator's take-off run (declared distances: TODA = TORA + CWY). Runway ends coincide with the thresholds (TORA = LDA = 3200 m, no displaced threshold).",
    "byTakeoffDesignator": {
      "14": { "lengthM": 425, "widthM": 150, "beyondThreshold": "32", "tora": 3200, "toda": 3625, "asda": 3440, "stopwayM": 240 },
      "32": { "lengthM": 300, "widthM": 150, "beyondThreshold": "14", "tora": 3200, "toda": 3500, "asda": 3350, "stopwayM": 150 }
    },
    "crossCheck": "TODA - TORA = 425 (RWY14) / 300 (RWY32) = AD 2.12 CWY column; ASDA - TORA = 240 / 150 = AD 2.12 SWY column; strip 3710 = 3200 + 240 + 150 + 2 x 60.",
    "source": "adall_2026-08-20.pdf, VGHS AD 2.12 (AD 2-5, 25 DEC 2025) and VGHS AD 2.13 (AD 2-6, 25 DEC 2025), AIP AMDT 05/25",
    "confidence": "HIGH_PIXEL_VERIFIED_R3 (page images rendered at 150 dpi and read in R3; supersedes the LOW-confidence text-layer reading in normalized/aerodromes/hsia.json#declaredDistances)"
  },
  "takeoffFinalWidth": {
    "valueM": 1800,
    "rule": "ANO 14 Vol I base Table 4-2 col (4) footnote c: '1 800 m when the intended track includes changes of heading greater than 15 degrees for operations conducted in IMC, VMC by night.'",
    "evidence": "VGHS AD 2.22 SIDs (AD 2-12, 22 FEB 2024; AD 2-13, 05 SEP 2024): RWY14 e.g. NIKLI ONE 'Maintain Runway heading to 1000 ft then turn left to intercept the 050 radial' (runway 143.7 deg -> ~50 deg, a turn of ~94 deg); RWY32 e.g. NIKLI TWO 'Maintain Runway heading to 1000ft then turn right to intercept the 050 radial' (323.7 deg -> ~50 deg, ~86 deg). SIDs are instrument procedures, i.e. flown in IMC and at night.",
    "confidence": "SOURCE_SUPPORTED",
    "residualAssumption": "ANO 14 4.1.29 (complex take-off surface following a turning track) is NOT modelled; the straight surface of 1800 m final width along the runway heading is used."
  },
  "takeoffInnerEdgeElevation": {
    "valueFt": 26,
    "rule": "ANO 14 4.1.27: highest point on the ground on the clearway centre line.",
    "status": "ASSUMED_RUNWAY_END_ELEVATION",
    "note": "No clearway ground profile is published in the sources held. AD 2.12 gives runway-end elevation 26 ft and runway/stopway slope 'Nil'. The runway-end elevation is used and flagged."
  },
  "balkedLandingInnerEdge": {
    "distanceAfterThresholdM": 1800,
    "rule": "ANO 14 Vol I Amdt 1 Table 4-1 col (10)/(11) '1 800 m' with footnote d 'Or end of runway whichever is less' (base Table 4-1 footnote d); 4.1.21-4.1.22: located at a specified distance AFTER the threshold.",
    "effectiveValueAtHsia": "min(1800, 3200) = 1800 m"
  },
  "innerHorizontalReference": {
    "status": "INNER_HORIZONTAL_REFERENCE_UNRESOLVED",
    "rule": "ANO 14 4.1.5 / 4.1.6 defer the reference point(s) and elevation datum to Airport Services Manual (Doc 9137) Part 6.",
    "searchResult": "Doc 9137 Part 6 is not held in the repository (only ANO cross-references to it). sources/other-official is empty. The 2018 Dhaka OLS map is a non-authoritative graphic with no construction data.",
    "retainedAssumption": "Stadium of radius 4000 m around the THR14-THR32 segment; datum = aerodrome elevation (unchanged from the released engine)."
  }
}
`,"normalized/ols/tejgaon-r4-geometry-supplement.json":`{\r
  "schemaVersion": "1.0",\r
  "phase": "R4",\r
  "aerodrome": "Tejgaon (VGTJ)",\r
  "purpose": "Source-traced Tejgaon inputs for the R4 candidate-code OLS engines. The aerodrome reference code is NOT resolved here; codes 1-4 are all evaluated. No value is derived from any CAAB clearance letter.",\r
  "pixelVerification": "adall_2026-08-20.pdf pages 263-264 (VGTJ AD 2-3 / AD 2-4, 25 DEC 2025, AIP AMDT 05/25) rendered at 130 dpi and read in R4.",\r
  "runwayFrame": {\r
    "thr17": {\r
      "coordinateOriginal": "234724.94N 0902244.87E",\r
      "latitudeDecimal": 23.790261,\r
      "longitudeDecimal": 90.379131,\r
      "elevationFt": 24\r
    },\r
    "thr35": {\r
      "coordinateOriginal": "234602.74N 0902309.83E",\r
      "latitudeDecimal": 23.767428,\r
      "longitudeDecimal": 90.386064,\r
      "elevationFt": 24\r
    },\r
    "trueBearingDeg": {\r
      "17": 164.24,\r
      "35": 344.24\r
    },\r
    "lengthM": 2622,\r
    "strip": "2859 x 280",\r
    "slopeOfRwySwy": "0.06% (both thresholds 24 ft; flat profile used)",\r
    "confidence": "HIGH_PIXEL_VERIFIED_R4 (AD 2.12)"\r
  },\r
  "aerodromeElevationFt": 24,\r
  "clearways": {\r
    "note": "Take-off surface inner edge = max(Table 4-2 distance from runway end, clearway length). The AD 2.12 CWY column and the AD 2.13 declared distances DISAGREE for RWY17; the shorter clearway is used because it puts the inner edge nearer the runway (lower surface = conservative).",\r
    "byTakeoffDesignator": {\r
      "17": {\r
        "lengthM": 100,\r
        "ad212CwyM": 140,\r
        "ad213TodaMinusToraM": 100,\r
        "used": "100 (min of conflicting values)",\r
        "beyondThreshold": "35"\r
      },\r
      "35": {\r
        "lengthM": 275,\r
        "ad212CwyM": 275,\r
        "ad213TodaMinusToraM": 275,\r
        "used": "275 (consistent)",\r
        "beyondThreshold": "17"\r
      }\r
    },\r
    "declaredDistancesConflict": "AD 2.13 TORA = 2744 m for both directions while AD 2.12 runway length = 2622 m and the threshold separation computes to 2625.7 m; RWY35 LDA 3019 > TORA 2744. The runway ends are taken at the thresholds (nearer inner edge = conservative). Flag TEJGAON_DECLARED_DISTANCES_INCONSISTENT."\r
  },\r
  "takeoffFinalWidth": {\r
    "code3or4M": 1200,\r
    "rule": "Table 4-2 col (4): 1200 m; 1800 m only for heading changes > 15 deg in IMC or VMC by night (fn c).",\r
    "evidence": "VGTJ AD 2.17/2.18 hours of applicability 'Sunrise to Sunset'; VGTJ AD 2.22: aircraft meeting IMC in the Tejgaon zone proceed to HSIA; Tejgaon has no instrument procedure (AD 2.14/2.19 NIL). Neither IMC nor night take-offs occur, so fn c does not apply."\r
  },\r
  "transitionalLowerEdge": {\r
    "halfWidthM": 140,\r
    "used": "physical strip half-width 140 m (AIP VGTJ AD 2.12 strip 2859 x 280) for every candidate code",\r
    "rule": "ANO 14 4.1.14a: the lower edge runs 'along the length of the strip parallel to the runway centre line'.",\r
    "note": "Conservative and literal: transitional height = slope x (lateral - edge), so the wider physical strip edge gives the LOWER surface. (An earlier R4 draft used the narrower non-instrument approach inner edge; that choice was permissive and was corrected before any result was reported.)"\r
  },\r
  "aerodromeReferenceCode": {\r
    "status": "UNRESOLVED",\r
    "note": "No authoritative code in any source held (C1.1/C2B). Codes 1, 2, 3, 4 non-instrument (Table 4-1 cols 2-5; Table 4-2 cols 1, 2, 3-or-4) are all evaluated; the code-4-from-runway-length shortcut is NOT used."\r
  },\r
  "airspaceEvidenceForOverlapRule": {\r
    "source": "VGTJ AD 2.17 (AD 2-4, 25 DEC 2025)",\r
    "tejgaonTowerLateralLimits": "A portion of the Dhaka CTR laterally bounded by a closed line joining A(234116.57N 0902427.57E) to B(232428.23N 0902223.48E) then along an arc of radius 25NM from Dhaka VOR up to C(235552.71N 0895824.17E) then to D(234920.99N 0902209.78E) thereafter along the center line of the RWY to A.",\r
    "computedCheck": "D lies 4.4 m from the extended Tejgaon centreline, 3706 m north of THR17; A lies 248 m east of it, 11698 m south of THR17 (D->A bearing 165.32 deg vs runway 164.39 deg). B and C lie WEST of the centreline (-11984 m, -35563 m).",\r
    "atz": "2 NM to the North from threshold RWY17, 5 NM to the South & West (semicircular from centre of runway).",\r
    "circlingObstacles": "All four VGTJ AD 2.10 circling-area obstacles are described as offset 'to the West side of RWY centre line'.",\r
    "conclusion": "The AIP uses the Tejgaon runway centre line (and its extension) as the eastern boundary of Tejgaon's own airspace; Tejgaon's airspace and circuit lie to the WEST."\r
  }\r
}`,"normalized/ols/ols-current-2026.json":`{
