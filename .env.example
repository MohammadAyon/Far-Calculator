# Required for production; local development can use data/far-calculator.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required in every environment for dataset import/revert. Generate with:
# openssl rand -base64 48
DATA_IMPORT_TOKEN=

# Optional comma-separated development origins allowed by Next.js.
ALLOWED_DEV_ORIGINS=

# Optional: email Foundrio when a customer requests a feasibility review (https://resend.com).
# Without these, requests are still saved and only appear in the architect dashboard.
# ENQUIRY_EMAIL_FROM must use a domain verified in Resend, e.g. "FAR Calculator <far@foundrio-bd.com>".
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=
ENQUIRY_EMAIL_FROM=
